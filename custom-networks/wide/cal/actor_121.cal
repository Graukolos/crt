		l_17 := l_8 * 18;
		l_9 := l_15 + x1_1;
		l_16 := l_0 / 32;
		y0_0 := l_6;
		y0_1 := l_9;
		y0_2 := l_18;
		y1_0 := l_15;
		y1_1 := l_0;
	end

	schedule fsm state0:
		state0(act0) --> state1;
		state1(act1) --> state2;
		state2(act2) --> state0;
		state2(act3) --> state0;
	end

	priority
		act3 > act2;
	end

end